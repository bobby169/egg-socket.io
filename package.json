    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@eggjs/bin": "^8.1.0",
    "@eggjs/mock": "^7.1.0",
    "@eggjs/redis": "^4.1.0",
    "@eggjs/session-redis": "^3.0.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "egg": "^4.2.0",
    "eslint": "^9.13.0",
